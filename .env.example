# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Free key from https://cimis.water.ca.gov/ (Register -> Web API -> App Key)
CIMIS_API_KEY=

# CIMIS station number nearest the farm. Look up at https://cimis.water.ca.gov/Stations.aspx
CIMIS_STATION_ID=
